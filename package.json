{
  "name": "traceli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm validate:env",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:env": "node --env-file-if-exists=.env.local scripts/validate-env.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "video:studio": "remotion studio remotion/index.ts",
    "video:render": "remotion render remotion/index.ts TraceliTenderToProof public/traceli-tender-to-proof.mp4 --codec=h264 --crf=16",
    "video:poster": "remotion still remotion/index.ts TraceliTenderToProof public/traceli-tender-to-proof-poster.png --frame=1010",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db/seed.mjs",
    "test:tenant": "node --env-file-if-exists=.env.local scripts/db/test-tenant-isolation.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.9.5",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.518",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "remotion": "4.0.518",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
