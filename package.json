{
  "name": "traceli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm validate:env",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:env": "node --env-file-if-exists=.env.local scripts/validate-env.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "video:studio": "remotion studio remotion/index.ts",
    "video:render": "remotion render remotion/index.ts TraceliTenderToProof public/traceli-tender-to-proof.mp4 --codec=h264 --crf=16",
    "video:poster": "remotion still remotion/index.ts TraceliTenderToProof public/traceli-tender-to-proof-poster.png --frame=1010",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db/seed.mjs",
    "test:tenant": "node --env-file-if-exists=.env.local scripts/db/test-tenant-isolation.mjs",
    "demo:agent": "node --conditions=react-server --import ./scripts/agent/register.mjs scripts/agent/demo.mjs",
    "test:agent": "node --conditions=react-server --import ./scripts/agent/register.mjs --test scripts/agent/test-evidence.mjs",
    "test:trace": "node --experimental-test-module-mocks --conditions=react-server --import ./scripts/agent/register.mjs --test scripts/trace/test-access.mjs scripts/trace/test-contract.mjs scripts/trace/test-public-contract.mjs",
    "test:award-desk": "node --experimental-strip-types --test scripts/award-desk/test-award-desk.mjs",
    "test:award-desk-freeze": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/field-registry/test-award-desk-freeze.mjs",
    "test:rule-library": "node --experimental-strip-types --test scripts/rule-library/test-rule-library.mjs",
    "test:field-registry": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/field-registry/test-field-registry.mjs",
    "test:extraction": "node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/field-registry/test-extraction.mjs",
    "test:upload-desk": "node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/desk/test-upload-desk.mjs scripts/desk/test-reviewer.mjs scripts/field-registry/test-pack-align.mjs",
    "test:hub": "node --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/hub/test-knowledge-hub.mjs scripts/hub/test-desk-continuity.mjs",
    "test:authkit": "node --experimental-test-module-mocks --experimental-strip-types --conditions=react-server --import ./scripts/field-registry/register.mjs --test scripts/auth/test-authkit-entry.mjs",
    "test:contradiction": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/field-registry/test-contradiction.mjs",
    "test:donor-packs": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/field-registry/test-donor-packs.mjs",
    "test:case-cards": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/case-cards/test-case-cards.mjs scripts/case-cards/test-checklist-groups.mjs",
    "test:pilot-report": "node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/pilot-report/test-pilot-report.mjs",
    "extract:stub": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs scripts/field-registry/extract-stub.mjs",
    "eval:extraction": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs eval/extraction/run.mjs",
    "test:extraction-eval": "node --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test eval/extraction/test-harness.mjs",
    "test:trace:postgres": "node --conditions=react-server --import ./scripts/agent/register.mjs scripts/trace/test-postgres.mjs",
    "test:trace:migration": "node scripts/trace/test-migration.mjs",
    "trace:seed": "node scripts/trace/seed-local.mjs",
    "test:hq": "node --conditions=react-server --import ./scripts/agent/register.mjs scripts/db/test-hq-postgres.mjs",
    "test:hq:access": "node --experimental-test-module-mocks --conditions=react-server --import ./scripts/agent/register.mjs --test scripts/hq/test-access.mjs",
    "test:hq:cloud": "node scripts/db/test-hq-cloud.mjs",
    "test:hq:worker": "node --test workers/hq/worker.test.mjs workers/hq/source-collector.test.mjs",
    "test:hq:sources": "node scripts/db/test-hq-source-collection.mjs",
    "test:hq:jev": "node --experimental-test-module-mocks --conditions=react-server --import ./scripts/agent/register.mjs --test scripts/hq/test-jev.mjs scripts/hq/test-jev-smoke.mjs",
    "test:tenders": "node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/tenders/test-http.mjs scripts/tenders/test-client-state.mjs",
    "test:tenders:postgres": "node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs scripts/tenders/test-postgres.mjs && node --experimental-test-module-mocks --conditions=react-server --experimental-strip-types --import ./scripts/field-registry/register.mjs --test scripts/tenders/test-access.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "^3.9.8",
    "@workos-inc/authkit-nextjs": "^4.3.2",
    "@workos-inc/node": "^10.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.517",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.28",
    "remotion": "4.0.517",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "zod": "4.4.3"
  }
}
