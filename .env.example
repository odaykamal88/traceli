# WorkOS AuthKit staging credentials. Never commit real secrets.
WORKOS_CLIENT_ID=""
WORKOS_API_KEY=""
WORKOS_COOKIE_PASSWORD=""
# For local AuthKit, use http://localhost:3000/auth/callback.
# Signup stays invite-only. Dashboard Redirects: docs/eng/workos-upload-desk.md.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=""

# Non-production Postgres. Use a pooled URL for the app and a direct URL for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
TRACELI_SEED_ORGANIZATION_ID=""

# Extraction adapter. Unset or mock stays offline and is the safe default.
# talonic calls POST {TRACE_TALONIC_BASE_URL}/extract. Empty base URL uses https://api.talonic.com/v1.
# Production stays mock until TRACE_EXTRACTION_PROVIDER is flipped to talonic after the client is deployed.
# TRACE_EXTRACTION_PROVIDER=mock
# TRACE_TALONIC_API_KEY=
# TRACE_TALONIC_BASE_URL=https://api.talonic.com/v1

# Upload desk uses the same Trace session as /api/trace.
# workos on Vercel requires the WorkOS variables above plus DATABASE_URL.
# local is development loopback only. See docs/eng/workos-upload-desk.md.
# TRACELI_TRACE_MODE=workos

# Durable tender workspace rollout (off by default). Requires migrated database.
# Only explicitly admitted organizations may create new managed tenders.
# Existing records are preserved; new managed tenders expire after 30 days.
# TRACELI_TENDER_WORKSPACES=1

# Required for hosted intake and the daily retention job (even with UI rollout off).
# TRACELI_TENDER_ORGANIZATIONS=org_verified_organization
# CRON_SECRET=<at least 32 random characters; server-only>

# Optional sanitized customer intake: subset of the admitted organizations above.
# Requires Talonic and the owner's approved processing route; no sensitive source data.
# TRACELI_TENDER_CUSTOMER_ORGANIZATIONS=org_verified_organization
# TRACELI_TENDER_CUSTOMER_RETENTION_DAYS=30
# TRACELI_TENDER_CUSTOMER_POLICY_VERSION=customer-sanitized-2026-09-28
# TRACELI_TENDER_CUSTOMER_PROVIDER_DISCLOSURE=<accurate provider/retention disclosure>
