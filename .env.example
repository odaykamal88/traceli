TRACELI_SEED_ORGANIZATION_ID=""

# Extraction adapter. Unset or mock stays offline. talonic is a skeleton until a vendor call exists.
# TRACE_EXTRACTION_PROVIDER=mock
# TRACE_TALONIC_API_KEY=
# TRACE_TALONIC_BASE_URL=
