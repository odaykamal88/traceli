{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "fictional": {
      "type": "boolean"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "external_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "system",
        "external_ref"
      ]
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "supported",
            "partial",
            "disputed",
            "unresolved"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "claim_id",
        "text",
        "state",
        "evidence_ids"
      ]
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "source_ref",
          "location",
          "applicability"
        ]
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "actor",
          "state",
          "at",
          "evidence_ref"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "custody": {
            "enum": [
              "fictional",
              "stored_reference_only",
              "verified_source_bytes"
            ]
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "source_ref",
          "version",
          "location",
          "content_hash",
          "custody",
          "excerpt"
        ]
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "item",
          "owner",
          "due_at",
          "state"
        ]
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution_criteria": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "owner",
          "resolution_criteria",
          "state"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepared_at": {
          "type": "string",
          "minLength": 1
        },
        "evidence_as_of": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "prepared_at",
        "evidence_as_of",
        "reviewed_at",
        "author",
        "review_ref",
        "limitations"
      ]
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "scoped"
          ]
        },
        "recipient_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_log_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "recipient_ids",
        "expires_at",
        "redaction_version",
        "access_log_ref",
        "revoked_at"
      ]
    }
  },
  "required": [
    "trace_id",
    "version",
    "classification",
    "fictional",
    "organization_id",
    "case_id",
    "transaction",
    "conclusion",
    "obligations",
    "approvals",
    "evidence",
    "missing_evidence",
    "exceptions",
    "provenance",
    "sharing"
  ]
}
