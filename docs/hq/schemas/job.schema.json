{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "workstream": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "charter_version": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "manual",
            "event",
            "schedule"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "reference",
        "dedupe_key"
      ]
    },
    "inputs_context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "read",
        "write"
      ]
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "schema_ref",
        "description"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deadline_sla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "due_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "starts_on": {
          "type": "string",
          "minLength": 1
        },
        "active_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "review_within_hours": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "due_at",
        "starts_on",
        "active_minutes",
        "review_within_hours"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "Green",
            "Amber",
            "Red"
          ]
        },
        "state": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level",
        "state",
        "actor",
        "record_ref",
        "artifact_hash",
        "expires_at"
      ]
    },
    "status": {
      "enum": [
        "intake",
        "ready",
        "running",
        "review",
        "changes_requested",
        "awaiting_approval",
        "accepted",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "requirement",
              "primary_source",
              "test",
              "artifact",
              "conversation",
              "send",
              "reply"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "source_ref",
          "location",
          "observed_at",
          "claim",
          "kind",
          "limitations"
        ]
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "USD"
          ]
        },
        "new_spend_limit": {
          "const": 0
        },
        "actual": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "measurement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "currency",
        "new_spend_limit",
        "actual",
        "tokens",
        "measurement"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_revisions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_tool_calls",
        "max_revisions"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "summary",
        "artifact_refs",
        "review_ref",
        "accepted_by",
        "accepted_at"
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "to",
        "when",
        "payload"
      ]
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependency_requirements": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "submitted",
          "accepted"
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "workstream",
    "objective",
    "owner",
    "persona",
    "charter_version",
    "trigger",
    "inputs_context",
    "allowed_tools",
    "allowed_memory",
    "expected_output",
    "acceptance_criteria",
    "deadline_sla",
    "approval",
    "status",
    "dependencies",
    "reviewer",
    "evidence",
    "cost",
    "limits",
    "result",
    "handoff",
    "blocker",
    "dependency_requirements"
  ]
}
